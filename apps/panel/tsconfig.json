{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": "../../",
    "paths": {
      "@codex-realtime-board/shared": ["packages/shared/src/index.ts"],
      "@codex-realtime-board/shared/*": ["packages/shared/src/*"]
    },
    "noEmit": true
  },
  "include": ["src"]
}
